{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-commit.ps1\" || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-commit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/track-tests.ps1\" || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-tests.sh\""
          }
        ]
      }
    ]
  }
}
